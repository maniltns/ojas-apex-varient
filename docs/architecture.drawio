  <diagram id="roadmap" name="3. Phased Roadmap">
    <mxGraphModel dx="1300" dy="820" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1560" pageHeight="820" math="0" shadow="0">
      <root>
        <mxCell id="0" />
        <mxCell id="1" parent="0" />

        <mxCell id="t" value="Delivery Roadmap — POC to Enterprise Production" style="text;html=1;align=left;fontSize=22;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="40" y="18" width="900" height="32" as="geometry" />
        </mxCell>
        <mxCell id="ts" value="The PL/SQL orchestration (ACCOR_EBS_BOT_PKG, ACCOR_IAM_VALIDATOR_PKG) is stable across phases; only data sources, write mechanism and infra change." style="text;html=1;align=left;fontSize=12;fontStyle=2;fontColor=#666;" vertex="1" parent="1">
          <mxGeometry x="40" y="50" width="1100" height="20" as="geometry" />
        </mxCell>

        <mxCell id="cPoc" value="POC — DONE" style="swimlane;startSize=34;html=1;fillColor=#82B366;fontColor=#FFFFFF;fontStyle=1;fontSize=14;swimlaneFillColor=#EFF5EC;strokeColor=#5d8a3a;align=center;" vertex="1" parent="1">
          <mxGeometry x="40" y="100" width="350" height="560" as="geometry" />
        </mxCell>
        <mxCell id="cPocB" value="● APEX app 43171 — chat + admin&#10;● ACCOR_EBS_BOT_PKG (8 formatters,&#10;&#160;&#160;&#160;keyword router, gated payment)&#10;● ACCOR_IAM_VALIDATOR_PKG&#10;● 12 ACCOR_* mock tables, seeded&#10;● ACCOR_AUDIT_LOG + PENDING_APPROVALS&#10;● Property scope via INSTR()&#10;◐ Select AI optional (graceful fallback)&#10;● Unit test suite (24+ assertions)&#10;&#10;Data: local mock tables&#10;Write: direct gated DML on ACCOR_*&#10;Infra: ATP 23ai Always Free, shared APEX" style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;spacingLeft=10;spacingTop=8;" vertex="1" parent="1">
          <mxGeometry x="50" y="142" width="330" height="510" as="geometry" />
        </mxCell>

        <mxCell id="cP1" value="PHASE 1 — Secure Connectivity" style="swimlane;startSize=34;html=1;fillColor=#AAC92A;fontColor=#1A1A1A;fontStyle=1;fontSize=14;swimlaneFillColor=#F7F9EC;strokeColor=#8FA821;align=center;" vertex="1" parent="1">
          <mxGeometry x="420" y="100" width="350" height="560" as="geometry" />
        </mxCell>
        <mxCell id="cP1B" value="○ OCI VCN with private subnets&#10;&#160;&#160;&#160;(database + app tiers)&#10;○ FastConnect or IPSec VPN to&#10;&#160;&#160;&#160;on-prem EBS datacentre&#10;○ NSGs — private endpoints only&#10;○ OCI Identity Domains (federated SSO)&#10;○ Vault / Key Management&#10;○ WAF + Load Balancer at edge&#10;&#10;Outcome: hardened network and&#10;identity foundation; app still on&#10;local replica of demo data.&#10;&#10;Use cases (Phase 1 — 80): dynamic&#10;financial analytics — invoice inquiry,&#10;supplier/customer balance, GL/bank&#10;balances, journal status, trial balance,&#10;aging, supplier risk, expense trends." style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;spacingLeft=10;spacingTop=8;fontColor=#666;" vertex="1" parent="1">
          <mxGeometry x="430" y="142" width="330" height="510" as="geometry" />
        </mxCell>

        <mxCell id="cP2" value="PHASE 2 — Read Replication" style="swimlane;startSize=34;html=1;fillColor=#AAC92A;fontColor=#1A1A1A;fontStyle=1;fontSize=14;swimlaneFillColor=#F7F9EC;strokeColor=#8FA821;align=center;" vertex="1" parent="1">
          <mxGeometry x="800" y="100" width="350" height="560" as="geometry" />
        </mxCell>
        <mxCell id="cP2B" value="○ Oracle GoldenGate Serverless&#10;&#160;&#160;&#160;in OCI (unidirectional)&#10;○ Replicate EBS AP/AR/GL tables&#10;&#160;&#160;&#160;(AP_INVOICES_ALL, GL_BALANCES,&#10;&#160;&#160;&#160;GL_JE_HEADERS/LINES, PO_VENDORS…)&#10;○ Map EBS views over replicas in ATP&#10;○ ORDS REST layer; VPD row security&#10;○ RAG + 23ai AI Vector Search&#10;&#10;Outcome: near-real-time read of&#10;on-prem EBS; semantic retrieval.&#10;&#10;Use cases (Phase 2 — 30): knowledge&#10;&amp; context — &quot;why is invoice blocked?&quot;,&#10;&quot;what policy applies to approval?&quot;,&#10;month-end close blockers, OpEx drivers." style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;spacingLeft=10;spacingTop=8;fontColor=#666;" vertex="1" parent="1">
          <mxGeometry x="810" y="142" width="330" height="510" as="geometry" />
        </mxCell>

        <mxCell id="cP3" value="PHASE 3 — Write Path + Scale + Agentic" style="swimlane;startSize=34;html=1;fillColor=#AAC92A;fontColor=#1A1A1A;fontStyle=1;fontSize=13;swimlaneFillColor=#F7F9EC;strokeColor=#8FA821;align=center;" vertex="1" parent="1">
          <mxGeometry x="1180" y="100" width="350" height="560" as="geometry" />
        </mxCell>
        <mxCell id="cP3B" value="○ EBS Web Services via Integration&#10;&#160;&#160;&#160;Repository (ISG)&#10;○ OIC proxy: ATP REST → EBS PL/SQL&#10;&#160;&#160;&#160;(AP_PAYMENT_PUBLIC_PKG,&#10;&#160;&#160;&#160;GL_JOURNAL_IMPORT)&#10;○ Replace local DML with web-service&#10;&#160;&#160;&#160;callouts to OIC&#10;○ OKE + HPA — 1000+ concurrent users&#10;○ Autonomous Data Guard failover&#10;○ Private OCI GenAI / Accor GPT&#10;○ Per-agent split, tool registry,&#10;&#160;&#160;&#160;prompt registry, eval, circuit breakers&#10;&#10;Use cases (Phase 3 — 12 agents):&#10;forecasting, collections risk, self-healing&#10;reconciliation, autonomous exception&#10;handling, finance copilot." style="text;html=1;align=left;verticalAlign=top;fontSize=10;whiteSpace=wrap;spacingLeft=10;spacingTop=8;fontColor=#666;" vertex="1" parent="1">
          <mxGeometry x="1190" y="142" width="330" height="510" as="geometry" />
        </mxCell>

        <mxCell id="ra1" style="endArrow=classic;html=1;strokeWidth=3;strokeColor=#8FA821;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cPoc" target="cP1">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ra2" style="endArrow=classic;html=1;strokeWidth=3;strokeColor=#8FA821;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cP1" target="cP2">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>
        <mxCell id="ra3" style="endArrow=classic;html=1;strokeWidth=3;strokeColor=#8FA821;exitX=1;exitY=0.5;exitDx=0;exitDy=0;entryX=0;entryY=0.5;entryDx=0;entryDy=0;" edge="1" parent="1" source="cP2" target="cP3">
          <mxGeometry relative="1" as="geometry" />
        </mxCell>

        <mxCell id="rNote" value="Use-case counts and categories are indicative — detailed and finalised at the start of each phase." style="text;html=1;align=left;fontSize=11;fontStyle=2;fontColor=#666;" vertex="1" parent="1">
          <mxGeometry x="40" y="675" width="1100" height="20" as="geometry" />
        </mxCell>

      </root>
    </mxGraphModel>
  </diagram>

