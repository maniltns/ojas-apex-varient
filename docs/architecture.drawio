        <mxCell id="l2" style="endArrow=none;html=1;strokeColor=#999;dashed=1;dashPattern=4 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="335" y="130" as="sourcePoint" /><mxPoint x="335" y="930" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="l3" style="endArrow=none;html=1;strokeColor=#999;dashed=1;dashPattern=4 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="555" y="130" as="sourcePoint" /><mxPoint x="555" y="930" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="l4" style="endArrow=none;html=1;strokeColor=#999;dashed=1;dashPattern=4 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="775" y="130" as="sourcePoint" /><mxPoint x="775" y="930" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="l5" style="endArrow=none;html=1;strokeColor=#999;dashed=1;dashPattern=4 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="995" y="130" as="sourcePoint" /><mxPoint x="995" y="930" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="l6" style="endArrow=none;html=1;strokeColor=#999;dashed=1;dashPattern=4 4;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="1220" y="130" as="sourcePoint" /><mxPoint x="1220" y="930" as="targetPoint" /></mxGeometry></mxCell>

        <mxCell id="pA" value="Phase A — Request &amp; gate  (no DML on ledger)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FFF2CC;strokeColor=#D6B656;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="150" width="1260" height="22" as="geometry" />
        </mxCell>
        <mxCell id="w1" value="1. type &quot;Approve payment for ap_inv_1001&quot;" style="endArrow=classic;html=1;strokeWidth=2;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="125" y="195" as="sourcePoint" /><mxPoint x="335" y="195" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="w2" value="2. PROCESS_CHAT (injection + length cleared)" style="endArrow=classic;html=1;strokeWidth=2;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="335" y="240" as="sourcePoint" /><mxPoint x="555" y="240" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="w3" value="3. classify 'write' · validate_action(role='manager', property) → ALLOWED" style="endArrow=classic;html=1;strokeWidth=2;fontSize=11;align=left;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="555" y="285" as="sourcePoint" /><mxPoint x="640" y="285" as="targetPoint" /><Array as="points"><mxPoint x="640" y="275" /><mxPoint x="640" y="295" /></Array></mxGeometry></mxCell>
        <mxCell id="w4" value="4. create_pending_approval — INSERT status='pending', expires_at=+15min&#10;(auto-cancels any prior pending on this thread)" style="endArrow=classic;html=1;strokeWidth=2;fontSize=11;strokeColor=#B85450;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="555" y="335" as="sourcePoint" /><mxPoint x="775" y="335" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="w5" value="5. JSON {requires_approval=true, approval_payload={approval_id, invoice, amount}}" style="endArrow=classic;html=1;strokeWidth=2;fontSize=11;dashed=1;dashPattern=8 4;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="555" y="385" as="sourcePoint" /><mxPoint x="335" y="385" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="w6" value="6. show confirmation modal (invoice details · Confirm / Cancel)" style="endArrow=classic;html=1;strokeWidth=2;fontSize=11;dashed=1;dashPattern=8 4;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="335" y="430" as="sourcePoint" /><mxPoint x="125" y="430" as="targetPoint" /></mxGeometry></mxCell>

        <mxCell id="pB" value="Phase B — Confirm &amp; commit  (gated DML)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#D5E8D4;strokeColor=#82B366;align=left;verticalAlign=middle;fontSize=11;fontStyle=1;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="460" width="1260" height="22" as="geometry" />
        </mxCell>
        <mxCell id="w7" value="7. click &quot;Confirm payment&quot; → sends CONFIRM" style="endArrow=classic;html=1;strokeWidth=2;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="125" y="505" as="sourcePoint" /><mxPoint x="335" y="505" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="w8" value="8. PROCESS_CHAT &quot;CONFIRM&quot;" style="endArrow=classic;html=1;strokeWidth=2;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="335" y="550" as="sourcePoint" /><mxPoint x="555" y="550" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="w9" value="9. expire stale rows · SELECT latest pending for (thread,user) where exp&gt;now()" style="endArrow=classic;html=1;strokeWidth=2;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="555" y="595" as="sourcePoint" /><mxPoint x="775" y="595" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="w10" value="10. UPDATE ACCOR_AP_INVOICES SET status='paid'" style="endArrow=classic;html=1;strokeWidth=2;fontSize=11;strokeColor=#B85450;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="555" y="640" as="sourcePoint" /><mxPoint x="995" y="640" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="w11" value="11. UPDATE pending SET status='confirmed', confirmed_at=now()" style="endArrow=classic;html=1;strokeWidth=2;fontSize=11;strokeColor=#B85450;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="555" y="685" as="sourcePoint" /><mxPoint x="775" y="685" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="w12" value="12. log_audit('DML_EXECUTION','allowed') — autonomous tx" style="endArrow=classic;html=1;strokeWidth=2;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="555" y="730" as="sourcePoint" /><mxPoint x="1220" y="730" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="w13" value="13. render &quot;Payment Approved Successfully&quot; card" style="endArrow=classic;html=1;strokeWidth=2;fontSize=11;dashed=1;dashPattern=8 4;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="555" y="775" as="sourcePoint" /><mxPoint x="125" y="775" as="targetPoint" /></mxGeometry></mxCell>

        <mxCell id="fbT" value="Failure paths (out-of-band)" style="rounded=0;whiteSpace=wrap;html=1;fillColor=#FBF4F4;strokeColor=#B85450;align=left;verticalAlign=middle;fontSize=12;fontStyle=1;spacingLeft=10;" vertex="1" parent="1">
          <mxGeometry x="40" y="810" width="1260" height="26" as="geometry" />
        </mxCell>
        <mxCell id="fb" value="• Cancel (Esc / Cancel) → CANCEL_APPROVAL → cancel_pending_approval → UPDATE pending SET status='cancelled'. No ledger DML; audit row written.&#10;• Expiry (15 min idle) → CONFIRM finds no live row → clean error, no DML.&#10;• Analyst attempts approve → step 3 returns BLOCKED, audit row 'blocked / role denied', flow terminates before any pending row is created." style="text;html=1;align=left;verticalAlign=top;fontSize=11;whiteSpace=wrap;spacingLeft=10;spacingTop=4;" vertex="1" parent="1">
          <mxGeometry x="40" y="840" width="1260" height="70" as="geometry" />
        </mxCell>

