        <mxCell id="t" value="Sequence — Gated write flow:  manager &quot;Approve payment for ap_inv_1001&quot;" style="text;html=1;align=left;fontSize=20;fontStyle=1;fontColor=#1A1A1A;" vertex="1" parent="1">
          <mxGeometry x="40" y="18" width="1200" height="32" as="geometry" />
        </mxCell>
        <mxCell id="ts" value="Two-phase handshake backed by ACCOR_PENDING_APPROVALS. No DML on the ledger before an explicit CONFIRM. In the POC the UPDATE is local; Phase 3 routes it through OIC → EBS." style="text;html=1;align=left;fontSize=11;fontStyle=2;fontColor=#666;" vertex="1" parent="1">
