  <diagram id="seq-write" name="5. Sequence — Gated Write">
    <mxGraphModel dx="1400" dy="1000" grid="1" gridSize="10" guides="1" tooltips="1" connect="1" arrows="1" fold="1" page="1" pageScale="1" pageWidth="1340" pageHeight="1020" math="0" shadow="0">
