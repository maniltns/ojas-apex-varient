        <mxCell id="m12" value="12. sanitize via ALLOWED_TAGS · render in chat bubble" style="endArrow=classic;html=1;strokeWidth=2;fontSize=11;dashed=1;dashPattern=8 4;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="292" y="665" as="sourcePoint" /><mxPoint x="115" y="665" as="targetPoint" /></mxGeometry></mxCell>

        <mxCell id="fn" value="If the intent matches no formatter, the Bot Engine falls through to the optional Select AI gateway (DBMS_CLOUD_AI.GENERATE via EXECUTE IMMEDIATE); when that is absent it returns a static help card. ORDS / VPD / PII redaction are Phase-1+ targets, not in this path today." style="rounded=0;whiteSpace=wrap;html=1;fillColor=#F7F9EC;strokeColor=#8FA821;align=left;verticalAlign=middle;fontSize=11;fontStyle=2;spacingLeft=12;" vertex="1" parent="1">
