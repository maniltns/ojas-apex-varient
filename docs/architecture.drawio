        <mxCell id="m1" value="1. type message + select property" style="endArrow=classic;html=1;strokeWidth=2;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="115" y="170" as="sourcePoint" /><mxPoint x="292" y="170" as="targetPoint" /></mxGeometry></mxCell>
        <mxCell id="m2" value="2. PROCESS_CHAT  {x01=message, x02=property_id}" style="endArrow=classic;html=1;strokeWidth=2;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="292" y="215" as="sourcePoint" /><mxPoint x="477" y="215" as="targetPoint" /></mxGeometry></mxCell>
