        <mxCell id="m7" value="7. SELECT ... FROM ACCOR_AP_INVOICES (property filter via INSTR)" style="endArrow=classic;html=1;strokeWidth=2;fontSize=11;verticalAlign=bottom;" edge="1" parent="1"><mxGeometry relative="1" as="geometry"><mxPoint x="847" y="440" as="sourcePoint" /><mxPoint x="1032" y="440" as="targetPoint" /></mxGeometry></mxCell>
