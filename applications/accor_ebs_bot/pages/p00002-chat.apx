page 2 (
    name: Chat Workspace
    alias: CHAT
    title: Chat Workspace
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
        authorizationScheme: @authenticated-finance-user
    }

    region breadcrumbs (
        name: Breadcrumbs
        title: Chat Workspace
        type: breadcrumb
        layout {
            sequence: 5
            slot: breadcrumbBar
        }
        appearance {
            template: @/breadcrumb
            templateOptions: #DEFAULT#
        }
        source {
            breadcrumb: @breadcrumb
        }
    )

    region chat-shell (
        name: EBS Finance Orchestrator
        type: staticContent
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        source {
            htmlCode:
                ```html
                <link rel="stylesheet" href="#APP_FILES#css/ebs-bot.css">
                <script src="#APP_FILES#js/ebs-bot.js" defer></script>
                <section id="ebs-shell" data-role="">
                  <header class="ebs-header">
                    <div class="ebs-brand">
                      <span class="ebs-brand__mark">A</span>
                      <span class="ebs-brand__name">
                        Grandback (EBS) Finance
                        <small>Conversational Console</small>
                      </span>
                    </div>
                    <div class="ebs-property">
                      <select class="ebs-property__select" aria-label="Active property"></select>
                    </div>
                    <div class="ebs-user">
                      <span class="ebs-user__name" data-user-name></span>
                      <span class="ebs-role-pill" data-role-pill></span>
                    </div>
                  </header>

                  <div class="ebs-quick">
                    <button type="button" class="ebs-chip" data-prompt="Show AP aging">AP_AGING</button>
                    <button type="button" class="ebs-chip" data-prompt="Show AR aging">AR_AGING</button>
                    <button type="button" class="ebs-chip" data-prompt="List overdue invoices">OVERDUE</button>
                    <button type="button" class="ebs-chip" data-prompt="Show GL balances">GL_BALANCES</button>
                    <button type="button" class="ebs-chip" data-prompt="Consolidated portfolio">PORTFOLIO</button>
                    <button type="button" class="ebs-chip" data-prompt="Show journals">JOURNALS</button>
                    <button type="button" class="ebs-chip" data-prompt="Property summary">PROPERTY_SUMMARY</button>
                    <button type="button" class="ebs-chip" data-write="true" data-prompt="Approve payment for ap_inv_1001">APPROVE_PAYMENT</button>
                  </div>

                  <div class="ebs-feed" role="log" aria-live="polite"></div>

                  <div class="ebs-typing">
                    <span class="ebs-typing__dots"><span></span><span></span><span></span></span>
                    <span>Bot is thinking</span>
                  </div>

                  <form class="ebs-composer" onsubmit="return false;">
                    <textarea class="ebs-input"
                              placeholder="Ask about AP aging, GL balances, vendors, or approve a payment…"
                              rows="1"
                              aria-label="Message"></textarea>
                    <button type="button" class="ebs-send">
                      Send <span class="ebs-send__kbd">⏎</span>
                    </button>
                  </form>
                </section>

                <div id="ebs-modal" class="ebs-modal-backdrop" role="dialog" aria-modal="true" aria-labelledby="ebs-modal-title" aria-hidden="true">
                  <div class="ebs-modal">
                    <h2 id="ebs-modal-title" class="ebs-modal__title">Confirm payment</h2>
                    <p class="ebs-modal__sub">This action commits a DML update against the EBS replica and is logged in the audit trail.</p>
                    <dl class="ebs-modal__list">
                      <div style="display:contents"><dt>Invoice ID</dt><dd data-slot="invoice-id">—</dd></div>
                      <div style="display:contents"><dt>Number</dt><dd data-slot="invoice-number">—</dd></div>
                      <div style="display:contents"><dt>Amount</dt><dd data-slot="amount">—</dd></div>
                    </dl>
                    <div class="ebs-modal__actions">
                      <button type="button" class="ebs-btn" data-action="cancel">Cancel</button>
                      <button type="button" class="ebs-btn ebs-btn--primary" data-action="confirm">Confirm payment</button>
                    </div>
                  </div>
                </div>
                ```
        }
    )

)
