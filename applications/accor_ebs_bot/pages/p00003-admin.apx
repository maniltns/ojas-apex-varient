page 3 (
    name: Admin Governance
    alias: ADMIN
    title: Admin Governance
    appearance {
        pageTemplate: @/standard
        templateOptions: #DEFAULT#
    }
    navigation {
        cursorFocus: doNotFocusCursor
    }
    security {
        pageAccessProtection: argumentsMustHaveChecksum
        formAutoComplete: false
        authorizationScheme: @administration-rights
    }

    region breadcrumbs (
        name: Breadcrumbs
        title: Admin Governance
        type: breadcrumb
        layout {
            sequence: 5
            slot: breadcrumbBar
        }
        appearance {
            template: @/breadcrumb
            templateOptions: #DEFAULT#
        }
        source {
            breadcrumb: @breadcrumb
        }
    )

    region kpi-strip (
        name: Governance KPIs
        type: staticContent
        layout {
            sequence: 5
            slot: body
        }
        appearance {
            template: @/standard
            templateOptions: #DEFAULT#
        }
        source {
            htmlCode:
                ```html
                <link rel="stylesheet" href="#APP_FILES#css/ebs-bot.css">
                <div class="ebs-kpi-strip">
                  <div class="ebs-kpi"><span class="ebs-kpi__label">Blocked (24h)</span><span class="ebs-kpi__value" id="kpi-blocked-24h">…</span></div>
                  <div class="ebs-kpi"><span class="ebs-kpi__label">Injection attempts (24h)</span><span class="ebs-kpi__value" id="kpi-inject-24h">…</span></div>
                  <div class="ebs-kpi"><span class="ebs-kpi__label">DML executions (24h)</span><span class="ebs-kpi__value" id="kpi-dml-24h">…</span></div>
                  <div class="ebs-kpi"><span class="ebs-kpi__label">Active users</span><span class="ebs-kpi__value" id="kpi-users">…</span></div>
                </div>
                <script>
                (function(){
                  document.body.classList.add('ebs-shell-active');
                  function set(id, v){ var n=document.getElementById(id); if(n) n.textContent=v; }
                  apex.server.process('LOAD_GOV_KPIS', {}, {
                    dataType: 'json',
                    success: function(d){
                      set('kpi-blocked-24h',  d.blocked_24h || 0);
                      set('kpi-inject-24h',   d.injection_24h || 0);
                      set('kpi-dml-24h',      d.dml_24h || 0);
                      set('kpi-users',        d.active_users || 0);
                    }
                  });
                })();
                </script>
                ```
        }
    )

    region users-grid (
        name: Users Registry
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select u.user_id, u.email, u.name, u.role, u.ebs_role,
                       u.property_access, u.org_id,
                       (select max(timestamp)
                          from grandback_audit_log a
                         where upper(a.email) = upper(u.email)) as last_seen_at
                  from grandback_users u
                 order by u.name
                ```
        }
        layout {
            sequence: 10
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }

        column USER_ID (
            type: plainText
            heading {
                heading: User ID
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
        )
        column EMAIL (
            type: plainText
            heading {
                heading: Email
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
        )
        column NAME (
            type: plainText
            heading {
                heading: Name
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
        )
        column ROLE (
            type: plainText
            heading {
                heading: Role
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
        )
        column EBS_ROLE (
            type: plainText
            heading {
                heading: EBS Role
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
        )
        column PROPERTY_ACCESS (
            type: plainText
            heading {
                heading: Property Access
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
        )
        column ORG_ID (
            type: plainText
            heading {
                heading: Org ID
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
        )
        column LAST_SEEN_AT (
            type: plainText
            heading {
                heading: Last seen
            }
            layout {
                sequence: 80
            }
            source {
                dataType: DATE
            }
        )
    )

    region audit-logs-grid (
        name: Audit Trail
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select log_id, email, role, action_type, intent,
                       property_id, query_text, status, reason, timestamp
                  from grandback_audit_log
                 order by timestamp desc
                ```
        }
        layout {
            sequence: 20
            slot: body
        }
        appearance {
            template: @/interactive-report
            templateOptions: #DEFAULT#
        }

        column LOG_ID (
            type: plainText
            heading {
                heading: Log ID
            }
            layout {
                sequence: 10
            }
            source {
                dataType: STRING
            }
        )
        column EMAIL (
            type: plainText
            heading {
                heading: Email
            }
            layout {
                sequence: 20
            }
            source {
                dataType: STRING
            }
        )
        column ROLE (
            type: plainText
            heading {
                heading: Role
            }
            layout {
                sequence: 30
            }
            source {
                dataType: STRING
            }
        )
        column ACTION_TYPE (
            type: plainText
            heading {
                heading: Action
            }
            layout {
                sequence: 40
            }
            source {
                dataType: STRING
            }
        )
        column INTENT (
            type: plainText
            heading {
                heading: Intent
            }
            layout {
                sequence: 50
            }
            source {
                dataType: STRING
            }
        )
        column PROPERTY_ID (
            type: plainText
            heading {
                heading: Property
            }
            layout {
                sequence: 60
            }
            source {
                dataType: STRING
            }
        )
        column QUERY_TEXT (
            type: plainText
            heading {
                heading: Query
            }
            layout {
                sequence: 70
            }
            source {
                dataType: STRING
            }
        )
        column STATUS (
            type: plainText
            heading {
                heading: Status
            }
            layout {
                sequence: 80
            }
            source {
                dataType: STRING
            }
        )
        column REASON (
            type: plainText
            heading {
                heading: Reason
            }
            layout {
                sequence: 90
            }
            source {
                dataType: STRING
            }
        )
        column TIMESTAMP (
            type: plainText
            heading {
                heading: Timestamp
            }
            layout {
                sequence: 100
            }
            source {
                dataType: DATE
            }
        )
    )

    region security-events-grid (
        name: Blocked Security Events
        type: interactiveReport
        source {
            location: localDatabase
            type: sqlQuery
            sqlQuery:
                ```sql
                select log_id, email, role, action_type, intent,
                       property_id, query_text, reason, timestamp
                  from grandback_audit_log
                 where status = 'blocked'
                 order by timestamp desc
                ```
        }
        layout {
            sequence: 30
            slot: body
        }
        appearance {
